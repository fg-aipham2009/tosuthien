generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PdfFile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String   @unique
  title         String
  volume        String?
  author        String   @default("Hòa thượng Thích Duy Lực")
  filename      String
  folderPath    String   @default("pdf/") @map("folder_path")
  storagePath   String   @unique @map("storage_path")
  publicUrl     String   @map("public_url")
  coverImageUrl String?  @map("cover_image_url")
  pageCount     Int?     @map("page_count")
  fileSizeBytes BigInt?  @map("file_size_bytes")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  readingProgress ReadingProgress[]

  @@index([sortOrder], map: "idx_pdf_files_sort")
  @@map("pdf_files")
}

model ReadingProgress {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId  String   @map("device_id")
  pdfFileId String   @map("pdf_file_id") @db.Uuid
  lastPage  Int      @default(1) @map("last_page")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  pdfFile PdfFile @relation(fields: [pdfFileId], references: [id], onDelete: Cascade)

  @@unique([deviceId, pdfFileId])
  @@index([deviceId], map: "idx_reading_progress_device")
  @@index([pdfFileId], map: "idx_reading_progress_pdf")
  @@map("reading_progress")
}

model RagSource {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String          @unique
  title       String
  volume      String?
  author      String          @default("Hòa thượng Thích Duy Lực")
  sourceFile  String          @unique @map("source_file")
  folderPath  String          @default("text/") @map("folder_path")
  status      String   @default("pending")
  chunkCount  Int             @default(0) @map("chunk_count")
  ingestedAt  DateTime?       @map("ingested_at") @db.Timestamptz(6)
  embeddedAt  DateTime?       @map("embedded_at") @db.Timestamptz(6)
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  passages Passage[]

  @@index([status], map: "idx_rag_sources_status")
  @@index([sortOrder], map: "idx_rag_sources_sort")
  @@map("rag_sources")
}

model Passage {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ragSourceId String           @map("rag_source_id") @db.Uuid
  pageNum     Int?             @map("page_num")
  chunkType   String   @default("prose") @map("chunk_type")
  questionNum Int?             @map("question_num")
  content     String
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  ragSource  RagSource          @relation(fields: [ragSourceId], references: [id], onDelete: Cascade)
  embedding  PassageEmbedding?

  @@index([ragSourceId, pageNum], map: "idx_passages_rag_page")
  @@index([chunkType], map: "idx_passages_chunk_type")
  @@map("passages")
}

model PassageEmbedding {
  passageId String                      @id @map("passage_id") @db.Uuid
  embedding Unsupported("vector(384)")
  model     String?
  createdAt DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  passage Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@map("passage_embeddings")
}

model MediaCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mp3Tracks      Mp3Track[]
  youtubeVideos  YoutubeVideo[]

  @@map("media_categories")
}

model Mp3Track {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  title         String
  year          Int
  recordedAt    DateTime? @map("recorded_at") @db.Date
  location      String?
  description   String?
  folderPath    String    @map("folder_path")
  filename      String
  storagePath   String    @unique @map("storage_path")
  publicUrl     String    @map("public_url")
  durationSec   Int?      @map("duration_sec")
  fileSizeBytes BigInt?   @map("file_size_bytes")
  sortOrder     Int       @default(0) @map("sort_order")
  isPublished   Boolean   @default(true) @map("is_published")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  category  MediaCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  favorites Mp3Favorite[]

  @@index([categoryId], map: "idx_mp3_tracks_category")
  @@index([year], map: "idx_mp3_tracks_year")
  @@index([categoryId, year(sort: Desc)], map: "idx_mp3_tracks_category_year")
  @@index([folderPath], map: "idx_mp3_tracks_folder")
  @@map("mp3_tracks")
}

model Mp3Favorite {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId   String   @map("device_id")
  mp3TrackId String   @map("mp3_track_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  track Mp3Track @relation(fields: [mp3TrackId], references: [id], onDelete: Cascade)

  @@unique([deviceId, mp3TrackId])
  @@index([deviceId], map: "idx_mp3_favorites_device")
  @@index([mp3TrackId], map: "idx_mp3_favorites_track")
  @@map("mp3_favorites")
}

model YoutubeVideo {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  title       String
  youtubeId   String    @map("youtube_id")
  channel     String    @default("Hoà thượng Thích Duy Lực")
  year        Int?
  publishedAt DateTime? @map("published_at") @db.Date
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  isPublished Boolean   @default(true) @map("is_published")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  category MediaCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId], map: "idx_youtube_videos_category")
  @@index([year], map: "idx_youtube_videos_year")
  @@index([categoryId, year(sort: Desc)], map: "idx_youtube_videos_category_year")
  @@map("youtube_videos")
}

model Center {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String?               @unique
  templeName     String                @map("temple_name")
  abbotName      String?               @map("abbot_name")
  /// Rank prefix: HT, TT, ĐĐ, NS, SC
  abbotRank      String?               @map("abbot_rank")
  /// Role at temple: Trụ trì, Viện chủ, …
  abbotTitle     String?               @map("abbot_title")
  /// Org role from sheet: Chứng minh, Phó, TBTK, …
  orgRole        String?               @map("org_role")
  /// TANG = chư tăng, NI = chư ni
  genderSection  String?               @map("gender_section")
  /// BAC | TRUNG | NAM | NUOC_NGOAI
  region         String?
  countryCode    String?               @map("country_code")
  province       String?
  address        String?
  phone          String?
  abbotPhone     String?               @map("abbot_phone")
  googleMapsUrl  String?               @map("google_maps_url")
  lat            Float?
  lng            Float?
  activityHours  String?               @map("activity_hours")
  rules          String?
  customs        String?
  mainImageUrl   String?               @map("main_image_url")
  galleryImages  Json                  @default("[]") @map("gallery_images")
  detailContent  String?               @map("detail_content")
  displayOrder   Int                   @default(0) @map("display_order")
  isPublished    Boolean               @default(true) @map("is_published")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  courses Course[]

  @@index([displayOrder], map: "idx_centers_display_order")
  @@index([region], map: "idx_centers_region")
  @@index([province], map: "idx_centers_province")
  @@map("centers")
}

model Course {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  /// REGULAR | SPRING | WINTER | AN_CU | OTHER
  type         String?
  /// ONCE | WEEKLY | MONTHLY_RANGE | YEARLY | SELF_PRACTICE
  recurrence   String?
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  /// For MONTHLY_RANGE e.g. 10–16
  dayStart     Int?      @map("day_start")
  dayEnd       Int?      @map("day_end")
  /// 0=Sunday … 6=Saturday for WEEKLY
  weekday      Int?
  /// Raw schedule text from sheet for display fallback
  scheduleText String?   @map("schedule_text")
  centerId     String?   @map("center_id") @db.Uuid
  contact      String?
  description  String?
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  center Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  @@index([centerId], map: "idx_courses_center")
  @@index([type], map: "idx_courses_type")
  @@map("courses")
}

/// Danh mục tin tức (admin Vue CRUD). Tách khỏi media_categories (mp3/youtube).
model PostCategory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wpSourceId  Int?      @unique @map("wp_source_id")
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  posts PostCategoryLink[]

  @@index([sortOrder], map: "idx_post_categories_sort")
  @@map("post_categories")
}

/// News posts (tin tức) for the public site.
model Post {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wpSourceId      Int?      @unique @map("wp_source_id")
  slug            String    @unique
  title           String
  excerpt         String?
  content         String?
  contentFormat   String    @default("html") @map("content_format")
  coverImageUrl   String?   @map("cover_image_url")
  sourceUrl       String?   @map("source_url")
  authorName      String?   @map("author_name")
  seoTitle        String?   @map("seo_title")
  seoDescription  String?   @map("seo_description")
  /// Public display date (list sort). Null = use createdAt.
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  isPinned        Boolean   @default(false) @map("is_pinned")
  sortOrder       Int       @default(0) @map("sort_order")
  isPublished     Boolean   @default(true) @map("is_published")
  /// Soft delete — excluded from list/detail when true.
  isDeleted       Boolean   @default(false) @map("is_deleted")
  /// news = free-form; class = lớp học; center = thiền đường.
  kind            String    @default("news")
  /// Structured class-notice fields (admin form; preferred over legacy HTML content).
  topicText       String?   @map("topic_text")
  teacherText     String?   @map("teacher_text")
  scheduleText    String?   @map("schedule_text")
  zoomMeetingId   String?   @map("zoom_meeting_id")
  zoomPass        String?   @map("zoom_pass")
  zoomUrl         String?   @map("zoom_url")
  zoomRoomId      String?   @map("zoom_room_id") @db.Uuid
  /// Optional prose below the poster.
  description     String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  categories PostCategoryLink[]
  images     PostImage[]
  zoomRoom   ZoomRoom? @relation(fields: [zoomRoomId], references: [id], onDelete: SetNull)

  @@index([isPublished, publishedAt(sort: Desc)], map: "idx_posts_published_at")
  @@index([isPinned, sortOrder], map: "idx_posts_pinned_sort")
  @@index([zoomRoomId], map: "idx_posts_zoom_room")
  @@index([isDeleted, createdAt(sort: Desc)], map: "idx_posts_not_deleted")
  @@index([kind], map: "idx_posts_kind")
  @@map("posts")
}

/// Shared Zoom rooms (dropdown for tin tức admin).
model ZoomRoom {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  meetingId   String   @map("meeting_id")
  pass        String?
  url         String?
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  posts Post[]

  @@index([sortOrder], map: "idx_zoom_rooms_sort")
  @@map("zoom_rooms")
}

/// Quan hệ nhiều-nhiều vì một bài WordPress có thể thuộc nhiều danh mục.
model PostCategoryLink {
  postId     String @map("post_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  post     Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  category PostCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId], map: "idx_post_category_links_category")
  @@map("post_category_links")
}

/// Danh mục ảnh của bài: cover và ảnh nằm trong HTML. DB giữ cả URL nguồn và URL local.
model PostImage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId      String   @map("post_id") @db.Uuid
  wpSourceId  Int?     @map("wp_source_id")
  role        String   @default("content")
  sourceUrl   String?  @map("source_url")
  url         String
  altText     String?  @map("alt_text")
  caption     String?
  mimeType    String?  @map("mime_type")
  width       Int?
  height      Int?
  fileSize    BigInt?  @map("file_size")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, sourceUrl])
  @@index([postId, sortOrder], map: "idx_post_images_post_sort")
  @@map("post_images")
}

/// Album hình ảnh trang /hinh-anh (admin Vue CRUD).
model GalleryAlbum {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String   @unique
  title         String
  description   String?
  coverImageUrl String?  @map("cover_image_url")
  sortOrder     Int      @default(0) @map("sort_order")
  isPublished   Boolean  @default(true) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  images GalleryImage[]

  @@index([sortOrder], map: "idx_gallery_albums_sort")
  @@index([isPublished], map: "idx_gallery_albums_published")
  @@map("gallery_albums")
}

/// Ảnh trong album. File lưu local DATA_ROOT/images/gallery/... ; DB chỉ giữ URL.
model GalleryImage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  albumId     String   @map("album_id") @db.Uuid
  url         String
  caption     String?
  altText     String?  @map("alt_text")
  width       Int?
  height      Int?
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId], map: "idx_gallery_images_album")
  @@index([albumId, sortOrder], map: "idx_gallery_images_album_sort")
  @@map("gallery_images")
}

/// Tài khoản đăng nhập admin (Vue admin).
model AdminUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String    @unique
  passwordHash String    @map("password_hash")
  displayName  String?   @map("display_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("admin_users")
}

/// Giảng sư / giáo thọ (admin CRUD + ảnh).
model Teacher {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  /// HT | TT | ĐĐ | NS | SC
  rank        String?
  name        String
  photoUrl    String?  @map("photo_url")
  bio         String?
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  defaultClasses DharmaClass[]        @relation("ClassDefaultTeacher")
  announcements  ClassAnnouncement[]

  @@index([sortOrder], map: "idx_teachers_sort")
  @@index([isPublished], map: "idx_teachers_published")
  @@map("teachers")
}

/// 3 lớp học cố định (thứ 5 / thứ 2 / thứ 7) + Zoom.
model DharmaClass {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// CLASS_THU_5 | CLASS_THU_2 | CLASS_THU_7
  code             String   @unique
  name             String
  shortName        String?  @map("short_name")
  /// 0=CN … 6=Thứ 7
  weekday          Int?
  timeText         String?  @map("time_text")
  zoomMeetingId    String?  @map("zoom_meeting_id")
  zoomPass         String?  @map("zoom_pass")
  zoomUrl          String?  @map("zoom_url")
  defaultTeacherId String?  @map("default_teacher_id") @db.Uuid
  sortOrder        Int      @default(0) @map("sort_order")
  isPublished      Boolean  @default(true) @map("is_published")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  defaultTeacher Teacher?            @relation("ClassDefaultTeacher", fields: [defaultTeacherId], references: [id], onDelete: SetNull)
  announcements  ClassAnnouncement[]

  @@index([sortOrder], map: "idx_dharma_classes_sort")
  @@map("dharma_classes")
}

/// Thông báo khóa học / poster lớp (Loại 1) — nền chung, đổi chữ + ảnh giảng sư.
model ClassAnnouncement {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId         String    @map("class_id") @db.Uuid
  teacherId       String?   @map("teacher_id") @db.Uuid
  templeName      String    @default("TRƯỜNG HẠ CHÙA PHẬT ĐÀ") @map("temple_name")
  templeAddress   String?   @map("temple_address")
  /// Đề tài lớn trên poster, vd. THIỀN CĂN BẢN 156
  topicTitle      String    @map("topic_title")
  /// Dòng phụ: Học trực tiếp và Trực tuyến…
  formatNote      String?   @map("format_note")
  teacherNameText String?   @map("teacher_name_text")
  teacherPhotoUrl String?   @map("teacher_photo_url")
  sessionDate     DateTime? @map("session_date") @db.Date
  lunarDateText   String?   @map("lunar_date_text")
  timeText        String?   @map("time_text")
  zoomMeetingId   String?   @map("zoom_meeting_id")
  zoomPass        String?   @map("zoom_pass")
  zoomUrl         String?   @map("zoom_url")
  resourcesNote   String?   @map("resources_note")
  /// Shared poster background key (default = poster-bg.png)
  backgroundKey   String    @default("default") @map("background_key")
  isPublished     Boolean   @default(true) @map("is_published")
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  dharmaClass DharmaClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher     Teacher?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([classId, sessionDate(sort: Desc)], map: "idx_class_announcements_class_date")
  @@index([isPublished, sessionDate(sort: Desc)], map: "idx_class_announcements_published")
  @@map("class_announcements")
}
