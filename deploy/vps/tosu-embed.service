[Unit]
Description=Tosu Thien Embed Server (BAAI/bge-m3 1024-d only)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tosu-thien
Environment=PATH=/opt/tosu-thien/.venv/bin:/usr/bin
EnvironmentFile=-/opt/tosu-thien/.env
# HARD-PIN after EnvironmentFile — stale MiniLM/384 in .env must never win.
Environment=EMBEDDING_MODEL=BAAI/bge-m3
Environment=EMBEDDING_DIM=1024
ExecStart=/opt/tosu-thien/.venv/bin/python3 -u scripts/embed_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
