# Copy → .env (local hoặc VPS production)
# cp .env.example .env
# Giải thích đầy đủ từng biến: docs/VPS-SETUP.md (Bước 5)

# =============================================================================
# DATABASE (PostgreSQL + pgvector)
# =============================================================================
POSTGRES_USER=tosuthien
POSTGRES_PASSWORD=thamthien
POSTGRES_DB=tosuthien
POSTGRES_PORT=5432

# Host scripts (ingest.py, embed.py) — localhost
DATABASE_URL=postgresql://tosuthien:thamthien@localhost:5432/tosuthien
# Container api tự dùng host "db" — không cần sửa DATABASE_URL cho Docker
# CBETA vector RAG — same Postgres instance, separate database (not tosuthien)
CBETA_DATABASE_URL=postgresql://tosuthien:thamthien@localhost:5432/cbeta
# Docker: postgresql://tosuthien:thamthien@db:5432/cbeta
# Optional CBETA chat tuning (omit = reuse book-RAG defaults where applicable)
# CBETA_CANDIDATE_POOL=
# CBETA_MAX_CONTEXT_CHARS=
# Neighbor expand: top 2 hits use asymmetric [-1,+2] + dialogue backshift; others center-only
# CBETA_EXPAND_HITS=
# Rewrite model (hhtech): claude-opus-5-5 (default) | claude-6-astra
# Answer path still uses HHTECH_CHAT_MODEL / Opus
# CBETA_REWRITE_MODEL=claude-opus-5-5
# Hard deadline for rewrite LLM (ms). On timeout → search with original question.
# CBETA_REWRITE_TIMEOUT_MS=15000
# In-memory LRU entries for rewrite (0=off)
# CBETA_REWRITE_CACHE_SIZE=256
# Brief/summary answers (tóm gọn / yếu chỉ) — smaller Opus budget for latency
# CBETA_BRIEF_MAX_TOKENS=6144

# CBETA_PG_POOL=4
# CBETA_DEEP_MAX_WORKS=   # coverage multi-pass: max works (omit = all matching title regex)
# CBETA_DEEP_CHUNK_PAGE=  # chunks per page when scanning a work
# Postgres regex for coverage seed titles (omit + no DEEP_MAX_WORKS → hybrid fallback)
# CBETA_COVERAGE_TITLE_REGEX=傳燈|五燈|指月|高僧傳|續燈|會元|燈錄|禪林|宗統|佛祖統|佛祖歷代|正宗記|傳法正宗
# VN/colloquial → Traditional Chinese search rewrite via hhtech before retrieve (1=on)
# CBETA_QUERY_REWRITE=1
# LLM output budgets (hhtech / Claude)
# CBETA_CHAT_MAX_TOKENS=196608
# CBETA_REWRITE_MAX_TOKENS=3072
# CJK n-gram sizes for FTS OR / lexical hybrid (comma-separated)
# CBETA_LEXICAL_NGRAMS=2,3
# CBETA Online reader link template ({linehead} | {workCode} | {ref})
# CBETA_ONLINE_URL_TEMPLATE=https://cbetaonline.dila.edu.tw/zh/{linehead}

# =============================================================================
# DOCKER COMPOSE
# =============================================================================
API_PORT=8000
ADMIN_PORT=5173

# =============================================================================
# API NESTJS
# =============================================================================
PORT=8000
PUBLIC_BASE_URL=https://api.tosuthien.net
DATA_ROOT=../data

# =============================================================================
# CHAT RAG — một model chung cho mọi provider: CHAT_MODEL
# CHAT_PROVIDER=flare | hhtech | nexus | shopaikey
# Fallback order: primary first, then CHAT_FALLBACK_PROVIDER (comma-separated)
# Default: 9flare → hhtech → nexus
# =============================================================================
CHAT_PROVIDER=flare
CHAT_MODEL=claude-opus-5-5
CHAT_FALLBACK_PROVIDER=hhtech,nexus

FLARE_API_KEY=
FLARE_BASE_URL=https://9flare.com/api/v1
FLARE_CHAT_MODEL=pro/claude-opus-5-5-medium

HHTECH_API_KEY=
HHTECH_BASE_URL=https://hhtechapi.com/v1
HHTECH_CHAT_MODEL=claude-opus-5-5

NEXUS_BASE_URL=https://api.nexusmmo.store/v1
NEXUS_API_KEY=
NEXUS_CHAT_MODEL=claude-opus-5-5

SHOPAIKEY_API_KEY=
SHOPAIKEY_BASE_URL=https://api.shopaikey.com
SHOPAIKEY_CHAT_MODEL=claude-opus-5-5

# =============================================================================
# EMBEDDING — local (scripts/embed_server.py), không tốn phí API
# REQUIRED for CBETA: BAAI/bge-m3 + 1024 (matches chunk_embeddings).
# FORBIDDEN: MiniLM / EMBEDDING_DIM=384 — breaks hybrid (Vector dim 1024 != 384).
# docker-compose hard-pins model/dim so a stale .env cannot override the API.
# =============================================================================
EMBEDDING_API_KEY=local
EMBEDDING_BASE_URL=http://localhost:7997/v1
EMBEDDING_BASE_URL_DOCKER=http://host.docker.internal:7997/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBED_PORT=7997
EMBED_THREADS=1
EMBED_BATCH=8

# =============================================================================
# OCR PDF — pdf_to_text.py (OCR_PROVIDER=hhtech | taphoa | nexus | shopaikey)
# =============================================================================
OCR_PROVIDER=hhtech
OCR_MODEL=claude-opus-4-6

TAPHOA_API_KEY=
TAPHOA_BASE_URL=https://taphoaapi.info.vn

# =============================================================================
# NGINX host (tham chiếu)
# =============================================================================
HTTP_PORT=80
HTTPS_PORT=443
